// --- KONFIGURASI PRISMA (TETAP SAMA) ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Gunakan SQLite untuk development
  provider = "sqlite" 
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   
  email     String   @unique 
  password  String   
  
  // PERBAIKAN INI: Role diubah menjadi String
  role      String   @default("USER")
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt    
  
  products  Product[] 
}

// ------------------------------------------------------------------
// 3. CONTOH ENTITAS INVENTORY (Untuk demonstrasi relasi)
// ------------------------------------------------------------------
model Product {
  id              Int      @id @default(autoincrement())
  name            String
  code            String?  @unique
  stock           Int
  price           Float
  
  // Relasi One-to-Many ke User (Ownership)
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Anda akan menambahkan relasi Category, Supplier, dll. di sini
}